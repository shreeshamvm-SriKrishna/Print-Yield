/** Adds hover definitions to headers, labels and names that match the glossary (prefix match, case-insensitive). */
function applyGlossary(root) {
  const keys = Object.keys(GLOSS).sort((a, b) => b.length - a.length);
  const find = txt => { const t = txt.toLowerCase().replace(/\s+/g, ' ').replace(/[·:—].*$/, '').trim(); if (!t) return null; if (GLOSS[t]) return GLOSS[t]; const k = keys.find(k => t.startsWith(k) && (t.length === k.length || /[\s(]/.test(t[k.length]))); return k ? GLOSS[k] : null; };
  root.querySelectorAll('th, .kpi .l, .mini .l, .eyebrow, table.matrix td:first-child, table.share .name, .share .name, .sec-head h2, .legend span, #filters label, .basis, table.plain td:first-child, .yt td.lvl').forEach(el => {
    if (el.title || el.querySelector('select')) { if (el.querySelector('select') && !el.title) { const d = find(el.firstChild && el.firstChild.textContent || ''); if (d) { el.title = d; el.classList.add('tt'); } } return; }
    const d = find(el.textContent || ''); if (d) { el.title = d; el.classList.add('tt'); }
  });
  document.querySelectorAll('#basisSel option').forEach(o => { const d = GLOSS[('yield ' + (BASIS_SHORT[o.value] || '')).toLowerCase()]; if (d) o.title = d; });
}
function glossaryHtml() {
  const show = ['earned', 'gross earned', 'yield', 'yield vs gross', 'yield vs rate card', 'yield vs adjusted rate card', 'discount', 'adjusted rate card', 'pages', 'revenue per page', 'drops', 'inserts', 'page category', 'page share', 'vs market', 'house ads', 'io status', 'mom', 'qoq', 'yoy'];
  return `<h4>Glossary — hover any underlined term on the page for its definition</h4><table><tbody>${show.map(k => `<tr><td>${esc(k.charAt(0).toUpperCase() + k.slice(1))}</td><td>${esc(GLOSS[k])}</td></tr>`).join('')}</tbody></table>`;
}

