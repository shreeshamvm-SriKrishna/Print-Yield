const NF = ['k', 'g', 'rc', 'rce', 'arc', 'arce', 'pg', 'n', 'ins', 'b', 'neg', 'comm', 'contr', 'cli', 'tier', 'kp', 'pgp'];
const MONEY = new Set(['k', 'g', 'rc', 'rce', 'arc', 'arce', 'b', 'comm', 'contr', 'cli', 'tier', 'kp']);
const pf = { region: '', year: '', period: '', group: '', brand: '', io: null, currency: '', yieldBasis: '' };
const E = () => { const o = {}; NF.forEach(f => o[f] = 0); return o; };
const addRow = (B, r) => { NF.forEach((f, i) => { B[f] += (r[11 + i] || 0) * (MONEY.has(f) ? FXF : 1); }); return B; };
const addB = (a, b) => { NF.forEach(f => a[f] += (b[f] || 0)); return a; };
const DEN = B => BASIS === 'ratecard' ? B.rce : B.g;
const Y = B => { const d = DEN(B); return d ? B.kp / d : 0; };   // yield on drops with a rate card only (numerator and denominator alike)
const COV = B => B.k ? B.kp / B.k : 0;   // priced coverage: share of earned that carries a rate card
const YRC = B => B.rce ? B.kp / B.rce : 0, YG = B => B.g ? B.kp / B.g : 0, DISC = B => B.g - B.kp;   // discount given away on priced drops
const RPP = B => B.pg ? B.k / B.pg : 0;
const pct1 = x => (100 * x).toFixed(1) + '%', pct0 = x => (100 * x).toFixed(0) + '%';
const fmtPg = x => (Math.round((x || 0) * 10) / 10).toLocaleString(undefined, { maximumFractionDigits: 1 });
const bl = () => BASIS_SHORT[BASIS] || 'vs Gross';
const grp = (rows, keyFn) => { const o = {}; rows.forEach(r => { const k = keyFn(r); addRow(o[k] || (o[k] = E()), r); }); return o; };
const sortK = o => Object.keys(o).sort((a, b) => o[b].k - o[a].k);
const sum = rows => rows.reduce((B, r) => addRow(B, r), E());
const notIns = r => r[F.group] !== 'Insert';
