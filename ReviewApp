  const dpg = Pb && Pb.pg ? B.pg / Pb.pg - 1 : null, dy = Pb && DEN(Pb) && DEN(B) ? Y(B) - Y(Pb) : null;
  const why = depth > 0.5 && B.pg >= 12 && (B.contr >= B.cli && B.contr >= B.comm) ? 'discount depth above 50 % on 12+ pages with contract as the largest part → renegotiate the contract tier at renewal' : depth > 0.5 && B.pg < 12 ? 'discount depth above 50 % on fewer than 12 pages → enforce the floor' : dpg !== null && dpg < -0.1 && dy !== null && dy < -0.02 ? 'pages down more than 10 % and yield down more than 2 pt → the discount is not buying volume' : dpg !== null && dpg > 0.1 && dy !== null && dy >= 0 ? 'pages up more than 10 % at a held or better yield → protect' : depth > 0.35 ? 'discount depth above 35 % → review terms' : 'within the book average → hold';
  return xp({ title: `${esc(name)} <span class="tiny">(${kind === 'client' ? 'advertiser' : 'agency'})</span>`, sub: `${esc(y1)} vs ${esc(y0)} · ${scopeLine()}`, def: 'Discount given = gross − net on this account\'s drops that carry a rate card; its parts come from the rate card text of each drop. Agency commission is the agency\'s remuneration and is shown as its own part.',
    formula: 'discount given = Σ gross − Σ priced earned · depth = discount ÷ gross · yield = priced earned ÷ gross',
    nums: [['Net (priced)', B.kp], ['Gross', B.g], ['Discount given', DISC(B), `${pct1(depth)} depth`], ['— contract', B.contr], ['— client', B.cli], ['— agency commission', B.comm], ['— off-card', Math.max(0, DISC(B) - B.contr - B.cli - B.comm)], ['Yield', pct1(Y(B))], ['Market avg (weighted by this account\'s markets)', bench === null ? '—' : pct1(bench)], ['Pages', fmtPg(B.pg)], [`Pages ${y0}`, Pb ? fmtPg(Pb.pg) : '—'], [`Yield ${y0}`, Pb && DEN(Pb) ? pct1(Y(Pb)) : '—']],
    reading: `${esc(name)} is given ${fmtM(DISC(B))} (${pct1(depth)} of its gross), mostly ${parts[0][0]} (${fmtM(parts[0][1])}). ${bench !== null ? `Its yield of ${pct1(Y(B))} is ${ptsFmt(Y(B) - bench)} against its markets' average.` : ''} ${dpg !== null ? `Pages ${pcFmt(dpg)} on ${esc(y0)}${dy !== null ? `, yield ${ptsFmt(dy)}` : ''}.` : ''} Suggested action because ${why}.`,
    change: 'Contract terms at renewal (contract part), price approvals (off-card), the commission switch in Settings (commission).' });
}

/* 03 page share row · 04 band row · 05 period row */
