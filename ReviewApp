    else if (shallow.n / T.n > 0.7) L.push(`Pricing discipline is <b>sound</b>: ${pct0(shallow.n / T.n)} of drops are within 25 % of the tier price, so the remaining gap to rate card is structural (tier adjustment ${pct1(T.rce ? T.tier / T.rce : 0)}) rather than negotiated.`);
