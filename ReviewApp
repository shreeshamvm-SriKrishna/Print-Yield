function sectionNotes(sec, title) { return `<a href="#" class="notes-link" data-notes="${esc(sec)}" data-x="${xa(() => xp({ title: `Notes — ${esc(title)}`, sub: 'General remarks on this section. Notes on a specific figure are written from that figure\'s panel.' }), 'section:' + sec, title)}">✎ Notes${sectionCount(sec) ? ` (${sectionCount(sec)})` : ''}</a>`; }
function notesSection() {
  if (!NOTES_LOADED) return '<div class="panel"><div class="empty">Loading notes…</div></div>';
  const L = NOTESD.notes; if (!L.length) return '<div class="panel"><div class="empty">No notes yet — open any figure and write the first one.</div></div>';
