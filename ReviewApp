/* ---------- briefing: written from the numbers of the current selection, against its benchmark ---------- */
function briefing(rows, rowsAll, T, pc, fc) {
  const M = CUBE.meta, L = [];
  const all = sum(CUBE.rows.filter(r => { const io = pf.io === null ? M.defaultIo : pf.io; return (!io || r[F.io] === io) && (!pf.year || r[F.period].startsWith(pf.year)) && (!pf.period || r[F.period] === pf.period); }));   // benchmark: everything in the same period, no market/brand/category filter
