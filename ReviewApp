      }).withFailureHandler(e => { document.getElementById('doUpload').disabled = false; st.textContent = e.message; })
      .uploadReport({ name: f.name, mime: f.type, base64: rd.result.split(',')[1] });
    };
    rd.readAsDataURL(f);
  };
}
