/* ---------- reviewer notes: stored in the sheet's Notes tab, attached to the figure they were written on ---------- */
let NOTESD = { owner: '', notes: [] }, NOTES_LOADED = false;
const notesFor = anchor => NOTESD.notes.filter(n => n.anchor === anchor);
const openCount = anchor => notesFor(anchor).filter(n => n.status === 'open').length;
const sectionCount = sec => NOTESD.notes.filter(n => n.status === 'open' && (n.anchor === 'section:' + sec || n.anchor.startsWith(sec + ':'))).length;
function loadNotes(cb) { google.script.run.withSuccessHandler(json => { try { NOTESD = JSON.parse(json || '{}'); NOTESD.notes = NOTESD.notes || []; } catch (e) { NOTESD = { owner: '', notes: [] }; } NOTES_LOADED = true; refreshNoteBadges(); if (cb) cb(); }).withFailureHandler(() => { NOTES_LOADED = true; if (cb) cb(); }).getNotes(); }
function refreshNoteBadges() { document.querySelectorAll('[data-notes]').forEach(el => { const n = sectionCount(el.dataset.notes); el.textContent = `✎ Notes${n ? ` (${n})` : ''}`; }); const s8 = document.getElementById('notesBody'); if (s8) s8.innerHTML = notesSection(); }
function noteItem(n) { const mine = n.author === USER || USER === NOTESD.owner; return `<div class="note${n.status === 'resolved' ? ' done' : ''}"><div class="nh"><b>${esc(n.author.split('@')[0])}</b> · ${esc(n.created)}${n.status === 'resolved' ? ` · resolved by ${esc(n.resolvedBy.split('@')[0])} ${esc(n.resolvedAt)}` : ''}<span class="na">${n.status === 'open' ? `<a href="#" data-nact="resolve" data-nid="${esc(n.id)}">Resolve</a>` : `<a href="#" data-nact="reopen" data-nid="${esc(n.id)}">Reopen</a>`}${mine ? ` · <a href="#" data-nact="delete" data-nid="${esc(n.id)}">Delete</a>` : ''}</span></div><div class="nt">${esc(n.text).replace(/\n/g, '<br>')}</div></div>`; }
function notesBlock(anchor, label) { const list = notesFor(anchor); return `<h4>Notes <span class="tiny">on “${esc(label)}” · visible to the reviewers of this report · kept in the sheet's Notes tab</span></h4><div class="notes" data-anchor="${esc(anchor)}" data-label="${esc(label)}">${list.length ? list.map(noteItem).join('') : '<div class="tiny" style="margin-bottom:6px">No notes yet.</div>'}<textarea class="ntext" rows="2" placeholder="Add a note for the other reviewers…"></textarea><div style="margin-top:6px"><button class="btn gold nadd">Add note</button> <span class="tiny nstat"></span></div></div>`; }
function bindNotes(root, entry) {
  root.querySelectorAll('.notes').forEach(box => {
    const anchor = box.dataset.anchor, label = box.dataset.label, stat = box.querySelector('.nstat');
    const refresh = json => { try { NOTESD = JSON.parse(json); } catch (e) {} refreshNoteBadges(); box.outerHTML = notesBlock(anchor, label); const nb = root.querySelector('.notes'); if (nb) bindNotes(root, entry); };
    const fail = err => { stat.textContent = (err && err.message) || String(err); stat.style.color = 'var(--neg)'; };
    box.querySelector('.nadd').onclick = () => { const t = box.querySelector('.ntext').value.trim(); if (!t) return; stat.textContent = 'Saving…'; google.script.run.withSuccessHandler(refresh).withFailureHandler(fail).addNote(anchor, label, t); };
    box.querySelectorAll('[data-nact]').forEach(a => a.onclick = e => { e.preventDefault(); if (a.dataset.nact === 'delete' && !window.confirm('Delete this note?')) return; stat.textContent = 'Saving…'; google.script.run.withSuccessHandler(refresh).withFailureHandler(fail).setNoteStatus(a.dataset.nid, a.dataset.nact); });
