    if (f.size > 45 * 1024 * 1024) { st.textContent = 'File is over 45 MB — drop it in the Drive folder instead.'; return; }
    const rd = new FileReader();
    rd.onload = () => {
      st.textContent = 'Uploading and rebuilding… this can take a minute for large files.';
      document.getElementById('doUpload').disabled = true;
      google.script.run.withSuccessHandler(res => {
        document.getElementById('doUpload').disabled = false;
        st.textContent = `Imported ${res.rows.toLocaleString()} rows.` + (res.missing.length ? ` Missing columns left blank: ${res.missing.join(', ')}` : '');
