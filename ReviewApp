  const neg = DISC(T), parts = [['contract discounts', T.contr], ['client discounts', T.cli], ['agency commission', T.comm]].sort((a, b) => b[1] - a[1]);
  const verdict = !bench || Math.abs(d) < 0.01 ? (bench ? `in line with ${bench}` : '') : d > 0 ? `<b>${(100 * d).toFixed(1)} points above</b> ${bench}` : `<b>${(100 * -d).toFixed(1)} points below</b> ${bench}`;
  // 0 · markets without a rate card: no yield verdict — revenue per page instead
  const unp = unpricedMarkets(rowsAll);
  const selUnpriced = COV(T) < UNPRICED_COV && T.k > 0;
  if (selUnpriced) {
    const isUnp = new Set(unp), pr = rowsAll.filter(r => notIns(r) && r[F.group] !== 'House Ad' && !isUnp.has(r[F.region])), bench = grp(pr, r => r[F.group]), bAll = sum(pr);
    const own = grp(rows.filter(r => notIns(r) && r[F.group] !== 'House Ad'), r => r[F.group]), ownAll = sum(rows.filter(r => notIns(r) && r[F.group] !== 'House Ad'));
    const ix = Object.keys(own).filter(g => own[g].pg >= 4 && bench[g] && bench[g].pg).map(g => ({ g, i: RPP(own[g]) / RPP(bench[g]), pg: own[g].pg })).sort((a, b) => a.i - b.i);
    const overall = bAll.pg && ownAll.pg ? RPP(ownAll) / RPP(bAll) : null;
    L.push(`${what} carries <b>no rate card in AdBook</b> (${pct0(COV(T))} of earned priced)${when}, so gross and yield cannot be measured here — it stays in earned, pages and page share. ${overall !== null ? `Per page it realises <b>${pct0(overall)}</b> of what the priced markets realise (${fmtN(RPP(ownAll))} vs ${fmtN(RPP(bAll))}).` : ''}`);
    if (ix.length >= 2) L.push(`By page category the gap is widest in <b>${esc(ix[0].g)}</b> (${pct0(ix[0].i)} of the priced markets' revenue per page on ${fmtPg(ix[0].pg)} pages)${ix[0].i < 0.7 ? ' — the first place to ask how those positions are priced' : ''}; strongest is <b>${esc(ix[ix.length - 1].g)}</b> at ${pct0(ix[ix.length - 1].i)}.`);
    L.push('To bring this market into the yield, its rate cards need to be attached to the positions in AdBook (or supplied as a rate card table).');
  } else if (!pf.region && unp.length) {
    const R = grp(rowsAll, r => r[F.region]); const isUnp = new Set(unp);
    const pr = rowsAll.filter(r => notIns(r) && r[F.group] !== 'House Ad' && !isUnp.has(r[F.region])), bAll = sum(pr);
    L.push(`${unp.map(m => `<b>${esc(m)}</b>`).join(', ')} ${unp.length > 1 ? 'carry' : 'carries'} no rate card in AdBook (${unp.map(m => pct0(R[m].k / (T.k || 1))).join(', ')} of net) and ${unp.length > 1 ? 'are' : 'is'} outside the yield figures above; ${unp.map(m => { const o = sum(rowsAll.filter(r => r[F.region] === m && notIns(r) && r[F.group] !== 'House Ad')); return bAll.pg && o.pg ? `${esc(m)} realises ${pct0(RPP(o) / RPP(bAll))} of the priced markets' revenue per page` : `${esc(m)} has no page-based positions to compare`; }).join('; ')} — see the per-page index under "Where to focus".`);
  }
  // 1 · verdict
  if (!selUnpriced) L.push(`${what} kept <b>${pct1(y)}</b> of the ${BASIS === 'ratecard' ? 'rate card' : 'tier price'}${when}${verdict ? ` — ${verdict}` : ''}. Of the ${fmtM(neg)} given up, ${pct0(neg ? parts[0][1] / neg : 0)} is ${parts[0][0]}${parts[1][1] > 0.15 * neg ? ` and ${pct0(parts[1][1] / neg)} ${parts[1][0]}` : ''}; ${parts[0][0] === 'agency commission' ? 'the leak is cost of sale rather than price concession' : parts[0][0] === 'contract discounts' ? 'this is contract terms, not day-to-day negotiation — the lever is the tier, not the sales floor' : 'this is discretionary discounting — the lever is price approval'}.`);
  // 2 · dispersion: is the result broad or concentrated?
  const bands = grp(rows, r => r[F.band]), deep = Object.keys(bands).filter(b => parseFloat(b) >= 50).reduce((a, b) => addB(a, bands[b]), E());
  const shallow = Object.keys(bands).filter(b => parseFloat(b) < 25).reduce((a, b) => addB(a, bands[b]), E());
