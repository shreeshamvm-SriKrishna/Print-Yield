function stackedChart(months, regions) {
  if (!months.length) return '<div class="empty">No monthly data</div>';
  const W = 1200, H = 340, padL = 70, padR = 16, padT = 16, padB = 44;
  const cw = W - padL - padR, ch = H - padT - padB;
  const maxV = Math.max(...months.map(m => Math.max(m.total, 0))) || 1;
  const step = niceStep(maxV / 4), top = Math.ceil(maxV / step) * step;
  const y = v => padT + ch - (v / top) * ch;
  const bw = Math.min(64, (cw / months.length) * 0.62), gap = cw / months.length;
  const color = r => COLORS[Math.max(0, regions.indexOf(r)) % COLORS.length];
  let s = `<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="Monthly revenue stacked by region">`;
  for (let v = 0; v <= top; v += step) s += `<line x1="${padL}" x2="${W-padR}" y1="${y(v)}" y2="${y(v)}" stroke="#e8e5dd"/><text x="${padL-8}" y="${y(v)+4}" text-anchor="end" font-size="11" fill="#6b6f76">${fmtM(v)}</text>`;
  months.forEach((m, i) => {
    const x = padL + gap * i + (gap - bw) / 2; let acc = 0;
    regions.forEach(r => { const v = m.byRegion[r] || 0; if (v <= 0) return;
      s += `<rect x="${x}" y="${y(acc+v)}" width="${bw}" height="${y(acc)-y(acc+v)}" fill="${color(r)}"><title>${esc(m.period)} · ${esc(r)}: ${fmtN(v)}</title></rect>`; acc += v; });
    s += `<text x="${x+bw/2}" y="${y(Math.max(m.total,0))-6}" text-anchor="middle" font-size="11" fill="#1b2430" font-weight="600">${fmtM(m.total)}</text>`;
    s += `<text x="${x+bw/2}" y="${H-padB+18}" text-anchor="middle" font-size="11" fill="#5f6b63">${shortPeriod(m.period)}</text>`;
  });
  s += `<line x1="${padL}" x2="${W-padR}" y1="${y(0)}" y2="${y(0)}" stroke="#1b2430"/></svg>`;
  s += `<div class="legend">${regions.map(r => `<span><i style="background:${color(r)}"></i>${esc(r)}</span>`).join('')}</div>`;
  return s;
}
const MN = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function shortPeriod(p) { const m = parseInt(p.slice(5,7),10); return (MN[m-1] || p) + ' ' + p.slice(2,4); }
function sparkline(months) {
  if (!months || months.length < 2) return '';
  const W = 640, H = 70, p = 6;
  const max = Math.max(...months.map(m => m.total)) || 1;
  const x = i => p + i * (W - 2 * p) / (months.length - 1), y = v => H - p - (v / max) * (H - 2 * p);
  const pts = months.map((m, i) => `${x(i).toFixed(1)},${y(Math.max(m.total, 0)).toFixed(1)}`).join(' ');
