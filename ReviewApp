    'Client discounts': ['Tier 3 / 4 amounts (Discount - Client 1/2 / Cumul des mandats / Dégressif volume / Taux de contrat)', 'Volume and client-specific discounts.'],
    'Agency commission': ['Tier 99 amounts (Agy Commission (DE) / Remise professionnelle)', 'The agency\'s remuneration; counted as lost yield while the Settings switch is on.'],
    'Off-card change': ['Adjusted Blended Revenue (the booked price) − AdjustedRateCard (the structured net), × earned fraction', 'What sales did on top of the card structure: negative = sold below the structured price (Britain\'s way of discounting), positive = above.'],
    'Net earned (priced)': ['Adjusted Earned Blended Revenue on drops with a rate card', 'What was actually earned on the priced positions.'] };
  const d = src[st.l] || ['', ''], share = B.rce ? Math.abs(st.v) / B.rce : 0;
  return xp({ title: `${esc(st.l)}${name ? ' — ' + esc(name) : ''}`, sub: scopeLine(), def: d[1], formula: d[0], nums: [[st.l, st.v], ['as % of the rate card', pct1(share)], ['Rate card (earned basis)', B.rce], ['Gross (tier price)', B.g], ['Net earned (priced)', B.kp]],
    reading: st.kind === 'total' ? `${fmtM(st.v)} — ${pct1(share)} of the list price.` : `${st.v < 0 ? 'Takes away' : 'Adds'} ${fmtM(Math.abs(st.v))}, ${pct1(share)} of the list price.${st.l === 'Off-card change' && st.v < -0.02 * B.rce ? ' A large negative here means the market negotiates on the price itself rather than through tiers — the lever is price-approval discipline, not contract terms.' : ''}${st.l === 'Policy tiers' && share > 0.15 ? ' More than 15 % of the list price goes before sales start negotiating — the card itself may be set above what the market bears.' : ''}`,
    change: st.kind === 'total' ? '' : 'Every drop\'s rate card text; the amounts are AdBook\'s, not estimated.' });
}

/* 02 focus cell / focus-list row / brand-across-markets cell */
function xCell(name, B, ref, refName, extra) {
  const y = Y(B), gap = y - ref, d = DEN(B);
  return xp({ title: esc(name), sub: scopeLine(), def: `Yield ${esc(bl())} of this cell against ${esc(refName)}. The cell needs a rate card to have a yield; the gap × the cell's ${basisWord()} denominator is the money at stake.`,
    formula: `yield = Σ priced earned ÷ Σ ${BASIS === 'ratecard' ? 'rate card' : 'gross'} · recoverable = (reference − yield) × denominator`,
    nums: [['Yield', pct1(y)], [refName, pct1(ref)], ['Gap', ptsFmt(gap)], ['Denominator (' + basisWord() + ')', d], ['Net earned (priced)', B.kp], ['Pages', fmtPg(B.pg)], ['Drops', fmtI(B.n)], [gap < 0 ? 'Recoverable at the reference' : 'Earned above the reference', Math.abs(gap * d)], ['Discount depth', pct1(B.g ? DISC(B) / B.g : 0), 'contract ' + fmtM(B.contr) + ' · client ' + fmtM(B.cli) + ' · commission ' + fmtM(B.comm)]],
    reading: gap < 0 ? `This cell keeps ${pct1(y)} of its price while ${esc(refName)} keeps ${pct1(ref)}: ${(100 * -gap).toFixed(1)} points less on ${fmtPg(B.pg)} pages. At the reference yield it would have earned ${fmtN(-gap * d)} more.${extra || ''}` : `This cell keeps ${pct1(y)}, ${(100 * gap).toFixed(1)} points above ${esc(refName)} — ${fmtN(gap * d)} earned above the reference on ${fmtPg(B.pg)} pages.${extra || ''}`,
    change: 'Its own discounting (section 04 bands), the contract terms of its accounts (section 07), or a different reference when the filters change.' });
}
const ACTION_RULE = { 'Contract terms — renegotiate the tier': 'more than 60 % of the cell\'s discount is contract discount', 'Deep discounting — enforce the floor': 'discount depth above 50 %', 'Price discipline — tighten approvals': 'below the market average without a dominant contract or deep-discount cause', 'Sell more pages at this price': 'above the market average on fewer than 12 pages', 'Protect the price; use as benchmark': 'above the market average on 12 pages or more' };

/* 04 scorecard row — the full analysis */
function xScore(x, pair, rowsT) {
  const r0 = rowsT.filter(r => r[F.region] === x.m && pair.f0(r)), r1 = rowsT.filter(r => r[F.region] === x.m && pair.f1(r)), B0 = sum(r0), B1 = sum(r1), pv = x.pv;
  const rule = x.dy === null || x.dpg === null ? 'no prior period to compare' : `pages ${pcFmt(x.dpg)} (threshold ±3 %) and yield ${ptsFmt(x.dy)} (threshold ±1 pt) → <b>${esc(x.read)}</b>`;
  const steps = (B) => bridgeSteps(B).map(st => [st.l, st.v]);
  const b0 = steps(B0), b1 = steps(B1);
  const bridgeTable = `<table class="plain"><thead><tr><th>Bridge step</th><th class="n">${esc(pair.l0)}</th><th class="n">${esc(pair.l1)}</th><th class="n">% of rate card ${esc(pair.l0)}</th><th class="n">% of rate card ${esc(pair.l1)}</th></tr></thead><tbody>${b1.map((st, i) => `<tr><td>${esc(st[0])}</td><td class="n">${fmtN(b0[i][1])}</td><td class="n">${fmtN(st[1])}</td><td class="n">${pct1(B0.rce ? Math.abs(b0[i][1]) / B0.rce : 0)}</td><td class="n">${pct1(B1.rce ? Math.abs(st[1]) / B1.rce : 0)}</td></tr>`).join('')}</tbody></table>`;
  const segs = pv.segs.slice().sort((a, b) => Math.abs(b.mix + b.rate + b.disc + b.priceNoCard) - Math.abs(a.mix + a.rate + a.disc + a.priceNoCard)).slice(0, 3);
  const pvm = `<table class="plain"><thead><tr><th>Effect</th><th class="n">${esc(CUR_LABEL())}</th><th>Driven by</th></tr></thead><tbody>
    <tr><td>Volume</td><td class="n">${signed(pv.volume)}</td><td class="tiny">${fmtPg(pv.pg1 - pv.pg0)} pages × ${fmtN(pv.P0)} average per page in ${esc(pair.l0)}</td></tr>
    <tr><td>Mix</td><td class="n">${signed(pv.mix)}</td><td class="tiny">${pv.segs.slice().sort((a, b) => Math.abs(b.mix) - Math.abs(a.mix)).slice(0, 3).map(sg => `${esc(sg.seg)} ${signed(sg.mix)}`).join(' · ')}</td></tr>
    <tr><td>Rate</td><td class="n">${signed(pv.rate)}</td><td class="tiny">${pv.segs.slice().sort((a, b) => Math.abs(b.rate) - Math.abs(a.rate)).slice(0, 3).map(sg => `${esc(sg.seg)} ${signed(sg.rate)}`).join(' · ')}</td></tr>
    <tr><td>Discount</td><td class="n">${signed(pv.disc)}</td><td class="tiny">${pv.segs.slice().sort((a, b) => Math.abs(b.disc) - Math.abs(a.disc)).slice(0, 3).map(sg => `${esc(sg.seg)} ${signed(sg.disc)}`).join(' · ')}</td></tr>
    ${Math.abs(pv.priceNoCard) > 0.5 ? `<tr><td>Price (no rate card)</td><td class="n">${signed(pv.priceNoCard)}</td><td class="tiny">positions without a rate card</td></tr>` : ''}<tr><td>Inserts & other</td><td class="n">${signed(pv.other)}</td><td class="tiny">non-page revenue</td></tr>
    <tr style="font-weight:600"><td>Net change</td><td class="n">${signed(pv.R1 - pv.R0)}</td><td class="tiny">${fmtN(pv.R0)} → ${fmtN(pv.R1)}</td></tr></tbody></table>`;
  const fg = familyGaps(rowsT.filter(pair.f1)), below = fg.below.filter(c => c.market === x.m).slice(0, 3), above = fg.above.filter(c => c.market === x.m).slice(0, 3);
  const brands = `<p>${below.length ? `Below the same title elsewhere: ${below.map(c => `<b>${esc(c.family)}</b> ${pct1(c.y)} vs ${pct1(c.ref)} (${fmtN(-c.amount)} at the family average)`).join('; ')}.` : 'No brand of this market is below its family average.'} ${above.length ? `Above: ${above.map(c => `<b>${esc(c.family)}</b> ${pct1(c.y)} vs ${pct1(c.ref)}`).join('; ')}.` : ''}</p>`;
  const bands1 = grp(r1, r => r[F.band]), deep1 = Object.keys(bands1).filter(b => parseFloat(b) >= 50).reduce((a, b) => addB(a, bands1[b]), E()), ch1 = grp(r1, r => r[F.channel]);
  const narrative = x.dy === null ? '' : `${esc(x.m)} ${x.dpg > 0.03 ? 'grew its pages' : x.dpg < -0.03 ? 'lost pages' : 'held its pages'} (${pcFmt(x.dpg)}) and ${x.dy > 0.01 ? 'improved' : x.dy < -0.01 ? 'lost' : 'held'} its yield (${ptsFmt(x.dy)}, now ${pct1(x.y1)}). Revenue moved ${signed(pv.R1 - pv.R0)}: ${[['volume', pv.volume], ['mix', pv.mix], ['rate', pv.rate], ['discount', pv.disc]].sort((a, b) => Math.abs(b[1]) - Math.abs(a[1])).slice(0, 2).map(e => `${e[0]} ${signed(e[1])}`).join(', ')}. ${x.deep > 0.3 ? `${pct0(x.deep)} of its net comes from drops discounted 50 % or more — discounting is broad, not a few deals.` : `Only ${pct0(x.deep)} of net sits in deep-discount bands.`} ${ch1.Agency && ch1.Direct && DEN(ch1.Agency) && DEN(ch1.Direct) ? `Agency business yields ${pct1(Y(ch1.Agency))} vs ${pct1(Y(ch1.Direct))} direct.` : ''} ${x.prem > 0.5 ? `Premium positions take ${pct0(x.prem)} of its pages.` : ''}`;
  const change = x.dy === null ? '' : x.read.startsWith('buys') ? `With the same pages, yield would need to recover ${(100 * (-x.dy - 0.01)).toFixed(1)} pt (≈ ${fmtN(Math.max(0, (-x.dy - 0.01)) * DEN(B1))}) for the reading to become "holds price and grows volume".` : x.read.startsWith('holds price, loses') ? `Pages would need to recover ${pcFmt(-x.dpg + 0.03)} at the current yield.` : x.read.startsWith('losing') ? `Both: pages ${pcFmt(-x.dpg + 0.03)} and yield ${ptsFmt(-x.dy + 0.01)}.` : x.read.startsWith('holds price and grows') ? `A yield drop of more than ${(100 * (x.dy + 0.01)).toFixed(1)} pt would turn it into "buys volume with discount".` : `A move of more than ±3 % in pages or ±1 pt in yield.`;
  return xp({ title: `${esc(x.m)} — how the reading was reached`, sub: `${esc(pair.l1)} vs ${esc(pair.l0)} (${esc(pair.note)}) · ${scopeLine()}`, def: `Rule: ${rule}.`, reading: narrative, change,
    extra: `<h4>Money bridge, both periods</h4>${bridgeTable}<h4>Price · volume · mix for ${esc(x.m)}</h4>${pvm}<h4>Brands against the same title in other markets</h4>${brands}` });
}

/* 05 PVM line — in the owner's "how to read it" style */
function xPvm(st, pv, pair) {
  const top = (key, n) => pv.segs.slice().sort((a, b) => Math.abs(b[key]) - Math.abs(a[key])).slice(0, n).filter(sg => Math.abs(sg[key]) > 0.5);
  const pct = v => pv.R0 ? ` (${pcFmt(v / pv.R0)} of ${esc(pair.l0)} net)` : '';
  const T = {
    'Volume': { def: `“We sold ${fmtPg(Math.abs(pv.pg1 - pv.pg0))} ${pv.pg1 >= pv.pg0 ? 'more' : 'fewer'} pages.” Valuing those pages at the ${esc(pair.l0)} average revenue per page gives ${signed(pv.volume)}${pct(pv.volume)}. This isolates the effect of selling more or fewer pages, before any change in prices or in the categories sold.`, formula: `(pages ${pair.l1} − pages ${pair.l0}) × (net ${pair.l0} ÷ pages ${pair.l0})`, nums: [[`Pages ${pair.l0}`, fmtPg(pv.pg0)], [`Pages ${pair.l1}`, fmtPg(pv.pg1)], [`Average revenue per page ${pair.l0}`, pv.P0], ['Volume effect', pv.volume]], change: 'Pages sold — the only input; price and mix are held at last period.' },
    'Mix': { def: `“The combination of page categories we sold was ${Math.abs(pv.mix) < 0.005 * pv.R0 ? 'broadly as valuable as before' : pv.mix > 0 ? 'more valuable' : 'less valuable'}.” Even with the same total pages, revenue moves when more pages fall into ${pv.mix > 0 ? 'higher' : 'lower'}-priced categories. Measured at ${esc(pair.l0)} category prices: ${signed(pv.mix)}${pct(pv.mix)}.${Math.abs(pv.mix) < 0.005 * pv.R0 ? ' Here the impact is small — the category mix was broadly neutral.' : ''}`, formula: `Σ over categories (pages ${pair.l1} − pages ${pair.l0}) × (category price per page ${pair.l0} − average price per page ${pair.l0})`, nums: top('mix', 5).map(sg => [sg.seg, sg.mix, `${fmtPg(sg.pg0)} → ${fmtPg(sg.pg1)} pages`]).concat([['Mix effect', pv.mix]]), change: 'The share of pages in premium vs standard positions.' },
    'Rate': { def: `“The gross (tier) price applied per page ${pv.rate >= 0 ? 'rose' : 'fell'}.” This is the pricing-policy effect — the card, before the separate discount effect: ${signed(pv.rate)}${pct(pv.rate)}. It is distinct from selling fewer pages or a different mix.`, formula: `Σ over categories priced pages ${pair.l1} × yield ${pair.l0} × (gross per page ${pair.l1} − gross per page ${pair.l0})`, nums: top('rate', 5).map(sg => [sg.seg, sg.rate]).concat([['Rate effect', pv.rate]]), change: 'Rate card prices and tier policy (Tier 0 / Special).' },
    'Discount': { def: `“We retained a ${pv.disc >= 0 ? 'larger' : 'smaller'} share of the gross price after discounts.” ${signed(pv.disc)}${pct(pv.disc)} of the change is attributed to ${pv.disc >= 0 ? 'better' : 'weaker'} price realisation through negotiation, separately from the gross rate.`, formula: `Σ over categories priced pages ${pair.l1} × gross per page ${pair.l1} × (yield ${pair.l1} − yield ${pair.l0})`, nums: top('disc', 5).map(sg => [sg.seg, sg.disc]).concat([['Discount effect', pv.disc]]), change: 'Discount depth per drop, contract terms, off-card pricing.' },
    'Price (no rate card)': { def: `“Revenue per page ${pv.priceNoCard >= 0 ? 'rose' : 'fell'} on positions without a rate card.” For these positions the bridge measures the change in realised revenue per page directly (${signed(pv.priceNoCard)}${pct(pv.priceNoCard)}) rather than splitting it into rate and discount, because there is no card to split against.`, formula: `unpriced pages ${pair.l1} × (revenue per page ${pair.l1} − revenue per page ${pair.l0})`, nums: top('priceNoCard', 5).map(sg => [sg.seg, sg.priceNoCard]).concat([['Price (no rate card)', pv.priceNoCard]]), change: 'Attaching rate cards in AdBook moves this line into rate and discount.' },
    'Inserts & other': { def: `“Revenue outside the page-based business ${pv.other >= 0 ? 'rose' : 'fell'}.” ${signed(pv.other)}${pct(pv.other)} on inserts (loose, bound-in, tip-on). The line alone does not say whether it came from volume or price, because inserts carry no pages.`, formula: `insert net ${pair.l1} − insert net ${pair.l0}`, nums: [['Inserts & other', pv.other]], change: 'Insert bookings and their prices.' },
  };
  const t = T[st.l]; if (!t) return xp({ title: esc(st.l), sub: `${esc(pair.l1)} vs ${esc(pair.l0)}`, nums: [[st.l, st.v]] });
  return xp({ title: `${esc(st.l)} — ${signed(st.v)}`, sub: `${esc(pair.l1)} vs ${esc(pair.l0)} (${esc(pair.note)}) · ${scopeLine()}`, def: t.def, formula: t.formula, nums: t.nums, change: t.change });
}

