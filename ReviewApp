    if (deepShare > 0.25) L.push(`Discounting is <b>broad</b>: ${pct0(deepShare)} of drops carry a discount of 50 % or more and they bring only ${pct0(deepNet)} of net at ${pct1(Y(deep))} yield — the shortfall is a pricing habit, not a handful of deals.`);
