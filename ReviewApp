<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><?= title ?></title>
<style>
  :root{
    --paper:#f4f2ec; --card:#ffffff; --ink:#14161a; --ink-2:#2b2f36; --muted:#6b6f76; --rule:#dcd8cf; --soft:#ece9e1;
    --brand:#0b0c0e; --gold:#b8933f; --rev:#1e3a5f; --rev-2:#2c5282; --billed:#b8933f; --neg:#a13a2b; --pos:#1e3a5f;
    --c1:#1e3a5f; --c2:#b8933f; --c3:#6b7f99; --c4:#a89f91; --c5:#c26a4a; --c6:#6b5b95; --c7:#4f7f8c; --c8:#9a9a9a;
    --serif:"Iowan Old Style","Palatino Linotype","Book Antiqua",Palatino,Georgia,"Times New Roman",serif;
    --sans:"Helvetica Neue",Helvetica,Arial,"Segoe UI",system-ui,sans-serif;
  }
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--paper);color:var(--ink);font:14px/1.5 var(--sans);font-variant-numeric:tabular-nums lining-nums}
  a{color:var(--rev)}
  button,select,input{font:inherit;color:inherit}
  h1,h2,h3,.serif{font-family:var(--serif)}

  /* Masthead */
  .mast{background:var(--brand);color:#fff}
  .mast .in{max-width:1480px;margin:0 auto;padding:18px 32px 16px;display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap}
  .wordmark{font-family:var(--serif);font-size:26px;letter-spacing:.22em;text-transform:uppercase;line-height:1;margin:0 0 10px;color:#fff}
  .wordmark img{height:26px;display:block}
  .mast h1{margin:0;font-size:30px;font-weight:400;letter-spacing:-.01em;line-height:1.1}
  .mast .meta{color:#b9bcc2;font-size:12.5px;margin-top:6px;letter-spacing:.02em}
  .mast .meta b{color:#fff;font-weight:500}
  .traffic{display:inline-block;margin-top:8px;font:12px var(--sans);color:#d9dbe0;background:#1b1d22;border:1px solid #3a3d44;border-radius:999px;padding:4px 10px}
  .traffic b{color:#fff;font-weight:600}
  .actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  .actions label{font-size:12px;color:#b9bcc2;display:flex;align-items:center;gap:6px}
  .actions select{padding:7px 10px;border:1px solid #3a3d44;border-radius:4px;background:#1b1d22;color:#fff}
  .btn{background:#fff;color:var(--brand);border:1px solid #fff;border-radius:4px;padding:8px 14px;cursor:pointer;font-weight:500}
  .btn.ghost{background:transparent;color:#fff;border-color:#4a4d55}
  .btn.gold{background:var(--gold);border-color:var(--gold);color:#111}
  .btn:disabled{opacity:.5;cursor:default}
  .btn:focus-visible,select:focus-visible{outline:2px solid var(--gold);outline-offset:2px}

  /* Section nav + filters */
  .topbar{position:sticky;top:0;z-index:5;background:rgba(244,242,236,.96);backdrop-filter:blur(6px);border-bottom:1px solid var(--rule)}
  .topbar .in{max-width:1480px;margin:0 auto;padding:0 32px}
  .topbar .row{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
  nav.toc{display:flex;gap:22px;font-size:12.5px;letter-spacing:.06em;text-transform:uppercase}
  nav.toc a{color:var(--muted);text-decoration:none;padding:12px 0;border-bottom:2px solid transparent}
  nav.toc a:hover{color:var(--ink);border-color:var(--gold)}
  .filters{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end;padding:8px 0 10px;border-top:1px solid var(--rule)}
  .filters label{font-size:11px;color:var(--muted);display:flex;flex-direction:column;gap:2px;text-transform:uppercase;letter-spacing:.05em}
  .filters select{min-width:140px;padding:6px 8px;border:1px solid var(--rule);border-radius:4px;background:#fff;font-size:13px;text-transform:none;letter-spacing:0}
  .filters .clear{align-self:flex-end;background:transparent;border:1px solid var(--rule);border-radius:4px;padding:7px 10px;cursor:pointer;color:var(--muted);font-size:12px}

  .wrap{max-width:1480px;margin:0 auto;padding:28px 32px 70px}

  /* Hero */
  .hero{display:grid;grid-template-columns:1.4fr 1fr;gap:20px;align-items:stretch}
  .hero .lead{background:var(--card);border:1px solid var(--rule);padding:26px 28px;position:relative;overflow:hidden}
  .hero .lead:before{content:"";position:absolute;left:0;top:0;bottom:0;width:6px;background:var(--rev)}
  .eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:0 0 6px}
  .big{font-family:var(--serif);font-size:56px;line-height:1;letter-spacing:-.02em;margin:0;color:var(--ink)}
  .big small{font-size:22px;color:var(--muted);letter-spacing:0;margin-left:8px}
  .lede{font-size:16px;color:var(--ink-2);margin:12px 0 0;max-width:60ch;line-height:1.5}
  .lede b{color:var(--rev)}
  .spark{margin-top:16px}
  .hero .side{display:grid;grid-template-rows:repeat(3,1fr);gap:12px}
  .mini{background:var(--card);border:1px solid var(--rule);padding:14px 18px;display:flex;justify-content:space-between;align-items:baseline}
  .mini .l{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
  .mini .v{font-family:var(--serif);font-size:26px;letter-spacing:-.01em}
  .mini .v.billed{color:var(--billed)}
  .delta{font-size:12px;padding:2px 7px;border-radius:3px;margin-left:8px;vertical-align:middle;font-family:var(--sans);white-space:nowrap;display:inline-block}
  .delta.up{background:#e4eaf2;color:var(--pos)} .delta.down{background:#f4e3df;color:var(--neg)}

  /* Summary */
  .summary{background:var(--card);border:1px solid var(--rule);padding:20px 26px;margin-top:20px;border-top:3px solid var(--gold)}
  .summary h2{margin:0 0 10px;font-size:19px;font-weight:400}
  .summary ul{margin:0;padding-left:18px;columns:2;column-gap:36px}
  .summary li{margin:0 0 7px;break-inside:avoid;color:var(--ink-2)}
  .summary b{color:var(--ink);font-weight:600}

  /* KPI tiles */
  .kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px;margin-top:28px}
  .kpis.counts{margin-top:12px}
  .kpi{background:var(--card);border:1px solid var(--rule);border-top:3px solid var(--rule);padding:12px 14px 12px}
  .kpi .l{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.08em}
  .kpi .v{font-family:var(--serif);font-size:24px;margin-top:4px;letter-spacing:-.01em}
  .kpi.head{border-top-color:var(--rev)} .kpi.head .v{color:var(--rev)}
  .kpi.billed{border-top-color:var(--billed)} .kpi.billed .v{color:var(--billed)}
  .kpis.counts .kpi .v{font-size:20px}
  .kpi .s{font-size:12px;color:var(--muted);margin-top:3px} .kpi .s b{color:var(--billed);font-weight:600}

  /* Sections */
  .sec{margin-top:44px}
  .sec-head{display:flex;align-items:baseline;gap:14px;border-bottom:1px solid var(--ink);padding-bottom:8px;margin-bottom:16px}
  .sec-head .num{font-family:var(--serif);color:var(--gold);font-size:14px;letter-spacing:.1em}
  .sec-head h2{margin:0;font-size:24px;font-weight:400;letter-spacing:-.01em}
  .sec-head .sub{color:var(--muted);font-size:13px;margin-left:auto}
  .panel{background:var(--card);border:1px solid var(--rule);padding:16px 18px;min-width:0}
  .panel h3{margin:0 0 10px;font-size:16px;font-weight:400;display:flex;justify-content:space-between;align-items:baseline}
  .panel h3 span{color:var(--muted);font-size:12px;font-family:var(--sans)}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px} .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
  .grid2>*,.grid3>*{min-width:0}

  svg text{font-family:var(--sans)}
  .legend{display:flex;flex-wrap:wrap;gap:14px;font-size:12px;color:var(--muted);margin-top:8px}
  .legend i{display:inline-block;width:10px;height:10px;margin-right:6px;vertical-align:-1px}

  table.bars{width:100%;border-collapse:collapse;font-size:13px}
  table.bars td{padding:6px 6px;border-bottom:1px solid var(--soft);vertical-align:middle}
  table.bars td.n{text-align:right;white-space:nowrap;width:110px;font-variant-numeric:tabular-nums}
  table.bars td.p{text-align:right;color:var(--muted);width:52px}
  table.bars td.b{width:38%}
  .bar{height:8px;background:var(--rev)} .bar.alt{background:var(--billed)}
  .name{max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

  .regions{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
  .rcard{background:var(--card);border:1px solid var(--rule);padding:14px 16px;cursor:pointer;text-align:left;border-top:3px solid var(--rule)}
  .rcard:hover{border-color:var(--gold)}
  .rcard.on{border-color:var(--rev);border-top-color:var(--rev);background:#eef1f6}
  .rcard .n{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
  .rcard .v{font-family:var(--serif);font-size:26px;color:var(--ink);margin-top:2px}
  .rcard .s{color:var(--muted);font-size:12px;margin-top:3px}
  .rcard .track{height:4px;background:var(--soft);margin-top:10px;overflow:hidden}
  .rcard .track i{display:block;height:100%;background:var(--rev)}

  table.matrix,table.pivot,table.plain{width:100%;border-collapse:collapse;font-size:12.5px}
  table.matrix{white-space:nowrap}
  table.matrix th,table.matrix td,table.pivot th,table.pivot td,table.plain th,table.plain td{padding:6px 9px;border-bottom:1px solid var(--soft)}
  table.matrix th,table.pivot th,table.plain th{background:var(--soft);font-weight:500;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-2);text-align:left}
  table.matrix th{text-align:right} table.matrix th:first-child{text-align:left}
  table.matrix td:first-child,table.matrix th:first-child{position:sticky;left:0;background:var(--card)} table.matrix th:first-child{background:var(--soft)}
  table.matrix td.n,table.pivot td.n,table.plain td.n,table.pivot th.n,table.plain th.n{text-align:right}
  table.matrix td.heat{background:var(--heat)}
  table.matrix tr.total td,table.pivot tr.grand td{font-weight:600;background:var(--ink);color:#fff}
  table.matrix tr.total td:first-child{background:var(--ink)}
  table.pivot{white-space:nowrap}
  table.pivot thead tr:last-child th{position:sticky;top:0;z-index:1}
  table.pivot .year th{background:#e2ded4;text-align:center;border-left:1px solid var(--rule)}
  table.pivot tr.sub td{font-weight:600;background:var(--soft)}
  table.pivot td.neg{color:var(--neg)}
  table.pivot tr.group-head td{cursor:pointer}
  table.pivot tr.group-head td:first-child{font-weight:600}
  table.pivot tr.group-head td:first-child::before{content:"▾ ";color:var(--muted);font-size:11px}
  table.pivot tr.group-head.closed td:first-child::before{content:"▸ "}
  .scroll{overflow:auto;max-height:640px;border:1px solid var(--rule);background:var(--card)}
  .sec-sub{color:var(--muted);font-size:13px;margin:0 0 12px}

  .empty{padding:40px;text-align:center;color:var(--muted)}
  .status{font-size:12px;color:#b9bcc2}
  .status.err{color:#f0a89c}
  dialog{border:1px solid var(--rule);padding:22px 24px;max-width:460px;width:92vw;font-family:var(--sans)}
  dialog::backdrop{background:rgba(20,22,26,.45)}
  dialog h3{margin:0 0 6px;font-size:18px;font-weight:400}
  dialog p{color:var(--muted);margin:0 0 12px}
  dialog .btn{background:var(--brand);color:#fff;border-color:var(--brand)} dialog .btn.ghost{background:#fff;color:var(--ink);border-color:var(--rule)}
  .loading{position:fixed;inset:0;background:rgba(244,242,236,.7);display:none;align-items:center;justify-content:center;font-size:15px;color:var(--muted)}
  .loading.on{display:flex}
  footer{max-width:1480px;margin:0 auto;padding:18px 32px 40px;border-top:1px solid var(--rule);color:var(--muted);font-size:12px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}

  /* Print Yield additions */
  .kpi .l .i{display:inline-block;width:14px;height:14px;line-height:14px;text-align:center;border:1px solid var(--rule);border-radius:50%;font-size:10px;color:var(--muted);margin-left:5px;cursor:help;text-transform:none;letter-spacing:0}
  details.method{background:var(--card);border:1px solid var(--rule);border-left:4px solid var(--gold);margin-top:20px;padding:0}
  details.method summary{cursor:pointer;padding:14px 18px;font-family:var(--serif);font-size:17px;list-style:none;display:flex;justify-content:space-between;align-items:baseline}
  details.method summary::-webkit-details-marker{display:none}
  details.method summary span{color:var(--muted);font-size:12px;font-family:var(--sans)}
  details.method table{width:100%;border-collapse:collapse;font-size:13px;margin:0 18px 16px;width:calc(100% - 36px)}
  details.method td{padding:7px 8px;border-top:1px solid var(--soft);vertical-align:top}
  details.method td:first-child{width:200px;font-weight:600;color:var(--ink-2);white-space:nowrap}
  table.matrix td .tiny{display:block;font-size:10px;color:var(--muted);line-height:1.1}
  table.matrix td.heat .tiny{color:inherit;opacity:.8}
  table.plain td.lvl{white-space:nowrap}
  table.plain tr.y0 td{font-weight:600;background:var(--soft)} table.plain tr.y1 td{font-weight:600}
  table.plain td.tog{cursor:pointer} table.plain td.tog::before{content:"▾ ";color:var(--muted);font-size:11px} table.plain tr.closed td.tog::before{content:"▸ "}
  .share{display:flex;flex-direction:column;gap:8px}
  .share .row{display:grid;grid-template-columns:150px 1fr 60px;gap:10px;align-items:center;font-size:12.5px}
  .share .bar{display:flex;height:18px;background:var(--soft);overflow:hidden}
  .share .bar i{display:block;height:100%}
  .share .n{text-align:right;color:var(--muted)}
  .focus td.gap{font-weight:600;color:var(--neg)} .focus td.gap.pos{color:var(--pos)}
  table.plain td.n span,table.plain td:first-child{white-space:nowrap}
  table.plain tr.leafrow td{background:#faf9f6;font-size:12px}
  .tt{text-decoration:underline dotted var(--muted);text-underline-offset:3px;cursor:help}
  th.tt,th .tt{text-decoration-color:#9a9a9a}
  .legend .tt{text-decoration:none}
  details.method h4{margin:14px 18px 6px;font:600 12px var(--sans);text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
  .basis{display:flex;flex-direction:column;gap:2px;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
  #filters select{min-width:120px}
  .basis select{min-width:200px;padding:6px 8px;border:1px solid var(--rev);border-radius:4px;background:#fff;font-size:13px;text-transform:none;letter-spacing:0;color:var(--rev);font-weight:600}
  .chip{display:inline-block;font-size:11px;padding:2px 8px;border:1px solid var(--rule);border-radius:999px;color:var(--muted);margin-left:6px;vertical-align:middle;text-transform:none;letter-spacing:0}
  @media (max-width:1100px){.kpis{grid-template-columns:repeat(3,1fr)}.grid2,.grid3{grid-template-columns:1fr}.hero{grid-template-columns:1fr}.hero .side{grid-template-rows:none;grid-template-columns:repeat(3,1fr)}}
  @media (max-width:640px){.kpis{grid-template-columns:repeat(2,1fr)}.big{font-size:40px}.hero .side{grid-template-columns:1fr}}
  @media print{
    @page{size:A4 landscape;margin:12mm 12mm 14mm}
    html,body{background:#fff;font-size:11px}
    .topbar,.actions,.loading,dialog{display:none!important}
    .mast{-webkit-print-color-adjust:exact;print-color-adjust:exact;padding:0}
    .mast .in{padding:10px 0}
    .wrap{max-width:none;padding:0}
    .hero{display:block}
    .hero .lead{margin-bottom:10px}
    .hero .side{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;grid-template-rows:none}
    .big{font-size:36px}
    .kpis{grid-template-columns:repeat(6,1fr);gap:8px;margin-top:12px}
    .kpi .v{font-size:16px}
    .summary ul{columns:2}
    .sec{break-before:page;page-break-before:always;margin-top:0}
    .sec-head{margin-top:0}
    .grid2,.grid3{display:block}
    .grid2>*,.grid3>*{margin-bottom:10px;width:100%}
    .panel,.kpi,.summary,.rcard,.mini{break-inside:avoid;page-break-inside:avoid;box-shadow:none}
    .regions{grid-template-columns:repeat(6,1fr);gap:8px}
    .scroll{max-height:none!important;overflow:visible!important;border:0}
    table{font-size:10px}
    table.matrix,table.pivot{font-size:7.5px} table.matrix th,table.matrix td,table.pivot th,table.pivot td{padding:2px 4px}
    thead{display:table-header-group}
    tfoot{display:table-footer-group}
    tr{break-inside:avoid;page-break-inside:avoid}
    table.pivot thead tr:last-child th{position:static}
    table.matrix td:first-child,table.matrix th:first-child{position:static}
    td.heat,tr.total td,tr.grand td,tr.sub td,.bar,.rcard .track i,.delta{-webkit-print-color-adjust:exact;print-color-adjust:exact}
    svg{max-height:260px}
    footer{border:0;padding:6px 0;font-size:9px}
    a[href]:after{content:""}
  }
  /* explain panels: every figure can be opened */
  [data-x]{cursor:pointer} [data-x]:hover{outline:1px dashed var(--gold);outline-offset:-1px}
  .xo{position:fixed;inset:0;background:rgba(27,36,48,.55);z-index:50;display:flex;align-items:flex-start;justify-content:center;padding:40px 16px;overflow:auto}
  .xp{background:var(--card);color:var(--ink);max-width:960px;width:100%;border-radius:8px;box-shadow:0 20px 60px rgba(0,0,0,.35);padding:22px 26px 26px;font-size:13px;line-height:1.5}
  .xp h2{font-family:Georgia,serif;font-weight:400;font-size:22px;margin:0 0 4px} .xp .xs{color:var(--muted);font-size:12px;margin-bottom:14px}
  .xp h4{margin:16px 0 6px;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-2)}
  .xp .read{background:var(--soft);border-left:3px solid var(--gold);padding:10px 12px;margin:8px 0}
  .xp table.plain{width:100%} .xp .close{float:right;background:none;border:1px solid var(--line);border-radius:4px;padding:4px 10px;cursor:pointer;color:var(--ink)}
  .xp code{background:var(--soft);padding:1px 5px;border-radius:3px;font-size:12px}
  .xp .grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px} @media (max-width:800px){.xp .grid2{grid-template-columns:1fr}}
  .notes .note{border-top:1px solid var(--line);padding:8px 0} .notes .note.done{opacity:.6} .notes .nh{font-size:11.5px;color:var(--muted)} .notes .na{float:right} .notes .nt{margin-top:3px;white-space:normal}
  .notes .ntext{width:100%;box-sizing:border-box;margin-top:8px;font:inherit;font-size:13px;padding:6px 8px;border:1px solid var(--line);border-radius:4px}
  .notes-link{font-size:11.5px;color:var(--gold);text-decoration:none;margin-left:10px;white-space:nowrap} #notes tr.done td{opacity:.6}
  .mast .credit{font-size:12.5px;color:#c9cdd4;margin:-4px 0 6px;letter-spacing:.02em}
</style>
</head>
<body>
<header class="mast"><div class="in">
  <div>
    <div class="wordmark" id="wordmark"><?= brandName ?></div>
    <h1><?= title ?></h1>
    <? if (creditLine) { ?><div class="credit"><i><?= creditLine ?></i></div><? } ?>
    <div class="meta" id="meta">Loading…</div>
    <div class="traffic" id="traffic" style="display:none"></div>
  </div>
  <div class="actions">
    <span class="status" id="status"></span>
    <label>Show in <select id="currency"></select></label>
    <button class="btn ghost" id="xlsBtn">Download Excel</button>
    <button class="btn ghost" id="pdfBtn">Print / PDF</button>
    <? if (canUpload) { ?><button class="btn gold" id="uploadBtn">Upload new report</button><? } ?>
    <button class="btn ghost" id="refreshBtn">Refresh</button>
  </div>
</div></header>

<div class="topbar"><div class="in">
  <div class="row"><nav class="toc"><a href="#summary">Summary</a><a href="#trend">Trend</a><a href="#regions">Markets</a><a href="#niches">Niches</a><a href="#breakdowns">Breakdowns</a><a href="#review">Review</a><a href="#detail">Detail</a><a href="#changes">Changes</a></nav></div>
  <div class="filters" id="filters">
    <label>Market <select data-f="region"></select></label>
    <label>Year <select data-f="year"></select></label>
    <label>Month <select data-f="period"></select></label>
    <label>Platform <select data-f="platform"></select></label>
    <label>IO status <select data-f="ioStatus"></select></label>
    <label>Billing <select data-f="billingStatus"></select></label>
    <label>Sales rep <select data-f="rep"></select></label>
    <label>Niche <select data-f="niche"></select></label>
    <label>Fee type <select data-f="feeType"></select></label>
    <button class="clear" id="clearBtn">Clear</button>
  </div>
</div></div>

<div class="wrap">
  <div id="app"><div class="empty">Loading the latest report…</div></div>
</div>
<footer><span><?= brandName ?> · <?= title ?> · Confidential — internal use only<? if (creditLine) { ?> · <i><?= creditLine ?></i><? } ?></span><span id="foot"></span></footer>

<dialog id="uploadDlg">
  <h3>Upload an AdBook+ export</h3>
  <p>CSV or XLSX, with the header row included. The file replaces the current dataset, is filtered to the canonical columns, and the dashboard rebuilds. Nothing leaves your Google Workspace.</p>
  <input type="file" id="file" accept=".csv,.tsv,.xlsx,.xls">
  <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px">
    <button class="btn ghost" id="cancelUpload">Cancel</button>
    <button class="btn" id="doUpload">Upload and rebuild</button>
  </div>
  <div class="status" id="upStatus" style="margin-top:8px;color:var(--muted)"></div>
</dialog>
<div class="loading" id="loading">Working…</div>

<script>
const CAN_UPLOAD = <?!= canUpload ? 'true' : 'false' ?>;
const USER = "<?= userEmail ?>";
const PROFILE = "<?= profile ?>";
const COLORS = ['#1e3a5f','#b8933f','#6b7f99','#a89f91','#c26a4a','#6b5b95','#4f7f8c','#9a9a9a','#d19a66','#3d4f63'];
const filters = { region:'', year:'', period:'', platform:'', ioStatus:'', billingStatus:'', rep:'', niche:'', feeType:'', currency:'' };
let optionsLoaded = false;

const fmtM = n => { const a = Math.abs(n); const s = n < 0 ? '−' : '';
  if (a >= 1e9) return s + (a/1e9).toFixed(2) + 'B'; if (a >= 1e6) return s + (a/1e6).toFixed(2) + 'M';
  if (a >= 1e3) return s + (a/1e3).toFixed(1) + 'K'; return s + a.toFixed(0); };
let NUMFMT = '#,##0';
const fmtN = n => { const dec = NUMFMT.includes('.00') ? 2 : 0; const grp = NUMFMT.includes(',');
  return n.toLocaleString(undefined, { minimumFractionDigits: dec, maximumFractionDigits: dec, useGrouping: grp }); };
const fmtI = n => n.toLocaleString();
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

function setLoading(on, msg) { const el = document.getElementById('loading'); el.textContent = msg || 'Working…'; el.classList.toggle('on', !!on); }
function setStatus(msg, err) { const el = document.getElementById('status'); el.textContent = msg || ''; el.classList.toggle('err', !!err); }

let loadTimer = null, loadSeq = 0;
function load() {
  if (PROFILE === 'print') return loadPrint();
  const seq = ++loadSeq;
  setLoading(true, 'Reading the report…');
  clearTimeout(loadTimer);
  loadTimer = setTimeout(() => { if (seq === loadSeq) setLoading(true, 'Still reading… the sheet may be busy (an import or rebuild running). If this persists, ask the owner to check Apps Script → Executions.'); }, 45000);
  google.script.run.withSuccessHandler(d => { if (seq !== loadSeq) return; clearTimeout(loadTimer); render(d); loadChanges(seq); })
    .withFailureHandler(e => { if (seq !== loadSeq) return; clearTimeout(loadTimer); setLoading(false); setStatus(e.message, true);
      document.getElementById('app').innerHTML = `<div class="empty">Could not load the report: ${esc(e.message)}<br><br>Try <b>Refresh</b>. If it keeps failing, the sheet owner can see the cause under Apps Script → Executions.</div>`; })
    .getDashboardData(filters);
}
function loadChanges(seq) {
  const el = document.getElementById('changes'); if (!el) return;
  google.script.run.withSuccessHandler(c => { if (seq !== loadSeq) return; const d = LAST_DATA; d.changes = c && !c.error ? c : null; d.changesError = c && c.error ? c.error : '';
      const tmp = document.createElement('div'); tmp.innerHTML = changesSection(d); el.replaceWith(tmp.firstElementChild); })
    .withFailureHandler(e => { const d = LAST_DATA; d.changes = null; d.changesError = e.message; const tmp = document.createElement('div'); tmp.innerHTML = changesSection(d); el.replaceWith(tmp.firstElementChild); })
    .getChangesData(filters);
}
let LAST_DATA = null;

function fillOptions(opts) {
  document.querySelectorAll('#filters select').forEach(sel => {
    const key = sel.dataset.f; if (!key) return; const cur = filters[key];
    let list = opts[key] || [];
    if (key === 'period' && filters.year) list = list.filter(p => String(p).startsWith(filters.year));
    sel.innerHTML = '<option value="">All</option>' + list.map(v => `<option value="${esc(v)}"${v===cur?' selected':''}>${esc(v)}</option>`).join('');
    sel.onchange = () => { filters[key] = sel.value; if (key === 'year') filters.period = ''; load(); };
  });
  optionsLoaded = true;
}

function render(d) {
  LAST_DATA = d;
  setLoading(false); setStatus('');
  fillOptions(d.options || {});
  const app = document.getElementById('app');
  if (d.empty) { app.innerHTML = '<div class="empty">No rows match these filters' + (CAN_UPLOAD ? ', or no report has been imported yet.' : '.') + '</div>'; document.getElementById('meta').textContent = ''; return; }
  const m = d.meta, t = d.totals;
  NUMFMT = d.numberFormat || '#,##0';
  const cs = document.getElementById('currency');
  cs.innerHTML = `<option value="">Auto (${esc(d.reportingCurrency)}${filters.region ? ' / market' : ''})</option>` + (d.currencies || []).map(c => `<option value="${esc(c)}"${filters.currency===c?' selected':''}>${esc(c)}</option>`).join('');
  cs.onchange = () => { filters.currency = cs.value; load(); };
  document.getElementById('meta').innerHTML = `Report run <b>${esc(m.runDate || '—')}</b> · ${fmtI(m.rows)} line items · all figures in <b>${esc(d.currency)}</b> · generated ${esc(m.generated)}${m.noPeriodRows ? ` · <span style="color:#f0c674">${fmtI(m.noPeriodRows)} line(s) without a month — included in totals, not in monthly views</span>` : ''}`;
  document.getElementById('foot').textContent = `Report run ${m.runDate || '—'} · generated ${m.generated}`;
  const tr = d.traffic, trEl = document.getElementById('traffic');
  if (tr && tr.opens) { trEl.style.display = 'inline-block'; trEl.innerHTML = `Last 7 days: <b>${fmtI(tr.people7)}</b> ${tr.people7 === 1 ? 'person' : 'people'} · <b>${fmtI(tr.opens7)}</b> opens &nbsp;·&nbsp; since launch: <b>${fmtI(tr.people)}</b> people · <b>${fmtI(tr.opens)}</b> opens · <b>${fmtI(tr.downloads)}</b> Excel downloads`; }
  else trEl.style.display = 'none';
  if (d.logo) document.getElementById('wordmark').innerHTML = `<img src="${esc(d.logo)}" alt="Condé Nast">`;

  const active = Object.keys(filters).filter(k => filters[k]).map(k => filters[k]);
  const scope = active.length ? active.join(', ') : 'all regions';
  const html = [];

  // 1. Summary — hero
  const last = d.months[d.months.length - 1], prev = d.months[d.months.length - 2];
  const mom = prev && prev.total ? 100 * (last.total - prev.total) / prev.total : null;
  const deltaHtml = mom === null ? '' : `<span class="delta ${mom >= 0 ? 'up' : 'down'}">${mom >= 0 ? '▲' : '▼'} ${Math.abs(mom).toFixed(1)}% vs ${shortPeriod(prev.period)}</span>`;
  html.push(`<div id="summary"></div>
  <section class="hero">
    <div class="lead">
      <p class="eyebrow">${esc(d.kpiName)} · ${esc(scope)}</p>
      <p class="big">${fmtN(t.kpi)}<small>${esc(d.currency)}</small></p>
      <p class="lede">Of which <b>${fmtM(t.billed)}</b> is billed — billing status complete (${t.kpi ? (100*t.billed/t.kpi).toFixed(0) : 0}%). ${last ? `Latest month ${shortPeriod(last.period)}: <b>${fmtM(last.total)}</b> ${deltaHtml}` : ''}</p>
      <div class="spark">${sparkline(d.months)}</div>
    </div>
    <div class="side">
      <div class="mini"><span class="l">Billed revenue · status ${esc((d.billedStatuses||['complete']).join('/'))}</span><span class="v billed">${fmtN(t.billed)}</span></div>
      <div class="mini"><span class="l">Adjusted billable</span><span class="v">${fmtN(t.billable)}</span></div>
      <div class="mini"><span class="l">Billed ÷ blended</span><span class="v">${t.kpi ? (100*t.billed/t.kpi).toFixed(1)+'%' : '—'}</span></div>
    </div>
  </section>`);
  html.push(execSummary(d));
  const billedSub = (b, k) => `Billed <b>${fmtN(b)}</b>${k ? ' · ' + (100*b/k).toFixed(0) + '%' : ''}`;
  const usF = d.usFees || [];
  const feeTiles = d.isUsView
    ? usF.slice(0, 3).map(f => kpi(`${f.name} · blended`, fmtN(f.kpi), 'head', billedSub(f.billed, f.kpi))).join('') + (usF.length < 3 ? kpi('US talent fees · total', fmtN(t.feeUs), '', billedSub(t.feeUsBilled, t.feeUs)) : '')
    : kpi('Talent fee internal · blended', fmtN(t.feeInternal), 'head', billedSub(t.feeInternalBilled, t.feeInternal)) +
      kpi('Talent fee external · blended', fmtN(t.feeExternal), 'head', billedSub(t.feeExternalBilled, t.feeExternal)) +
      (t.feeUs ? kpi(`US talent fees · ${esc(d.usMarket)}`, fmtN(t.feeUs), 'head', billedSub(t.feeUsBilled, t.feeUs)) : kpi('Fee internal share', t.kpi ? (100*t.feeInternal/t.kpi).toFixed(1)+'%' : '—'));
  html.push(`<div class="kpis">
    ${feeTiles}
    ${kpi('Campaigns', fmtI(m.campaigns))}${kpi('Clients', fmtI(m.clients))}${kpi('Avg per campaign', m.campaigns ? fmtN(t.kpi / m.campaigns) : '—')}
  </div>
  <div class="kpis counts">
    ${kpi('AdBook actual billed amount', fmtN(t.adbookBilled))}${kpi('Adjusted earned blended', fmtN(t.adjEarned))}${kpi('Pro-rata', fmtN(t.proRata))}
    ${kpi('Top market', d.byRegion[0] ? esc(d.byRegion[0][0]) : '—')}${kpi('Top niche', d.byCategory[0] ? esc(d.byCategory[0][0]) : '—')}${kpi('Top client', d.topClients[0] ? esc(d.topClients[0][0]) : '—')}
  </div>`);

  // 2. Trend
  html.push(`<section class="sec" id="trend"><div class="sec-head"><span class="num">01</span><h2>Monthly trend</h2><span class="sub">${esc(d.kpiName)} by month, stacked by market</span></div>`);
  html.push(`<div class="panel">${stackedChart(d.months, d.regions)}</div>`);
  html.push(momTable(d));
  html.push('</section>');

  // 3. Regions
  html.push(`<section class="sec" id="regions"><div class="sec-head"><span class="num">02</span><h2>Markets</h2><span class="sub">Consolidated split in ${esc(d.currency)} — click a market to open its report</span></div>`);
  html.push(regionsSection(d));
  html.push('</section>');

  // 4. Niches
  html.push(`<section class="sec" id="niches"><div class="sec-head"><span class="num">03</span><h2>Niches</h2><span class="sub">SSG Category · US: Campaign Name prefix — ${filters.region ? esc(filters.region) : "all markets"}</span></div>`);
  html.push(nicheSection(d));
  html.push('</section>');

  // 5. Breakdowns
  html.push(`<section class="sec" id="breakdowns"><div class="sec-head"><span class="num">04</span><h2>Breakdowns</h2><span class="sub">Share of ${esc(d.kpiName)} for the current selection</span></div>`);
  html.push(`<div class="grid2">
    ${feePanel(d)}
    ${usFeePanel(d)}
    ${barPanel('Top clients', d.topClients, t.kpi)}
    ${barPanel('Top agencies', d.topAgencies, t.kpi)}
    ${barPanel('By sales rep', d.byRep, t.kpi)}
    ${barPanel('By platform', d.byPlatform, t.kpi)}
  </div>
  <div class="grid3" style="margin-top:16px">
    ${barPanel('By IO status', d.byIO, t.kpi)}
    ${barPanel('By billing status', d.byBilling, t.kpi)}
    ${barPanel('By order source', d.byOrderSource, t.kpi)}
  </div></section>`);

  // 6. Review pivot
  html.push(`<section class="sec" id="review"><div class="sec-head"><span class="num">05</span><h2>Review</h2><span class="sub">Sum of ${esc(d.review.measure)} — IO status › job code › campaign · click an IO status to collapse</span></div>`);
  html.push(pivotTable(d.review));
  html.push('</section>');

  // 7. Detail
  html.push(`<section class="sec" id="detail"><div class="sec-head"><span class="num">06</span><h2>Top 25 campaigns</h2><span class="sub">by ${esc(d.kpiName)}</span></div>`);
  html.push(`<div class="scroll"><table class="plain">
    <thead><tr><th>Campaign</th><th>Client</th><th>Region</th><th>Sales rep</th><th>IO status</th><th class="n">${esc(d.kpiName)}</th><th class="n">Billed (complete)</th></tr></thead><tbody>
    ${d.topCampaigns.map(c => `<tr><td><div class="name" title="${esc(c.name)}">${esc(c.name || c.id)}</div><div style="color:var(--muted);font-size:11px">${esc(c.id)}</div></td><td>${esc(c.client)}</td><td>${esc(c.region)}</td><td>${esc(c.rep)}</td><td>${esc(c.io)}</td><td class="n">${fmtN(c.kpi)}</td><td class="n">${fmtN(c.billed)}</td></tr>`).join('')}
    </tbody></table></div></section>`);

  html.push(changesSection(d));

  app.innerHTML = html.join('');
  app.querySelectorAll('.rcard').forEach(b => b.addEventListener('click', () => {
    filters.region = filters.region === b.dataset.region ? '' : b.dataset.region; load();
  }));
  app.querySelectorAll('tr.group-head').forEach(tr => tr.addEventListener('click', () => {
    tr.classList.toggle('closed'); const g = tr.dataset.g;
    app.querySelectorAll(`tr[data-child="${g}"]`).forEach(r => r.style.display = tr.classList.contains('closed') ? 'none' : '');
  }));
}

function execSummary(d) {
  const t = d.totals, sp = d.regionSplit, N = d.nicheSplit, pts = [];
  const pct = (a, b) => b ? (100 * a / b).toFixed(1) + '%' : '—';
  if (sp && sp.regions.length > 1 && !filters.region) {
    const top = sp.regions.slice(0, 3);
    pts.push(`<b>${esc(top[0].name)}</b> is the largest market at ${fmtM(top[0].kpi)} (${pct(top[0].kpi, sp.totals.kpi)} of total)${top[1] ? `, followed by ${esc(top[1].name)} (${pct(top[1].kpi, sp.totals.kpi)})${top[2] ? ` and ${esc(top[2].name)} (${pct(top[2].kpi, sp.totals.kpi)})` : ''}` : ''}.`);
    const lowBill = sp.regions.filter(r => r.kpi > 0).sort((a, b) => (a.billed / a.kpi) - (b.billed / b.kpi))[0];
    if (lowBill) pts.push(`Lowest billing conversion is <b>${esc(lowBill.name)}</b> at ${pct(lowBill.billed, lowBill.kpi)} billed vs blended.`);
  }
  if (N && Object.keys(N.byNiche).length) {
    const niches = Object.keys(N.byNiche).sort((a, b) => N.byNiche[b] - N.byNiche[a]);
    pts.push(`Top niche is <b>${esc(niches[0])}</b> at ${fmtM(N.byNiche[niches[0]])} (${pct(N.byNiche[niches[0]], N.kpi)})${niches[1] ? `; ${esc(niches[1])} is second at ${pct(N.byNiche[niches[1]], N.kpi)}` : ''}.`);
  }
  if (d.months.length) {
    const best = d.months.reduce((a, b) => b.total > a.total ? b : a);
    pts.push(`Strongest month is <b>${shortPeriod(best.period)}</b> at ${fmtM(best.total)}.`);
    if (d.months.length > 1) {
      const last = d.months[d.months.length - 1], prev = d.months[d.months.length - 2];
      const ch = prev.total ? (100 * (last.total - prev.total) / prev.total) : 0;
      pts.push(`${shortPeriod(last.period)} came in at ${fmtM(last.total)}, <b>${ch >= 0 ? '+' : ''}${ch.toFixed(1)}%</b> vs ${shortPeriod(prev.period)}.`);
    }
  }
  if (d.byIO && d.byIO.length) {
    const io = d.byIO.slice(0, 2).map(x => `${esc(x[0])} ${pct(x[1], t.kpi)}`).join(', ');
    pts.push(`By IO status: ${io}.`);
  }
  if (d.isUsView && (d.usFees || []).length) pts.push(`US talent fees: ${d.usFees.filter(f => f.kpi).map(f => `<b>${esc(f.name)}</b> ${fmtM(f.kpi)} (${pct(f.kpi, t.kpi)})`).join(', ')}.`);
  else if (t.feeInternal || t.feeExternal) pts.push(`Talent fee split: internal <b>${fmtM(t.feeInternal)}</b> blended / ${fmtM(t.feeInternalBilled)} billed; external <b>${fmtM(t.feeExternal)}</b> blended / ${fmtM(t.feeExternalBilled)} billed${t.feeUs ? `; US talent fees <b>${fmtM(t.feeUs)}</b>` : ''}.`);
  if (d.topClients && d.topClients.length) pts.push(`Largest client is <b>${esc(d.topClients[0][0])}</b> at ${fmtM(d.topClients[0][1])} (${pct(d.topClients[0][1], t.kpi)}).`);
  pts.push(`${fmtM(t.billed)} of ${fmtM(t.kpi)} has billing status complete — <b>${pct(t.billed, t.kpi)}</b>.`);
  return `<div class="summary"><h2>Executive summary</h2><ul>${pts.map(p => `<li>${p}</li>`).join('')}</ul></div>`;
}

function momTable(d) {
  if (!d.months.length) return '';
  const rows = d.months.map((m, i) => {
    const prev = i ? d.months[i - 1].total : null;
    const ch = prev ? (100 * (m.total - prev) / prev) : null;
    return `<tr><td>${shortPeriod(m.period)}</td><td class="n">${fmtN(m.total)}</td><td class="n" style="color:${ch === null ? 'inherit' : ch >= 0 ? 'var(--rev)' : 'var(--neg)'}">${ch === null ? '—' : (ch >= 0 ? '+' : '') + ch.toFixed(1) + '%'}</td><td class="n">${d.totals.kpi ? (100 * m.total / d.totals.kpi).toFixed(1) : 0}%</td></tr>`;
  }).join('');
  return `<section class="grid2"><div class="panel"><h3>Month by month <span>${esc(d.kpiName)}</span></h3><div class="scroll" style="max-height:420px"><table class="plain"><thead><tr><th>Month</th><th class="n">Revenue</th><th class="n">vs prior month</th><th class="n">Share</th></tr></thead><tbody>${rows}</tbody></table></div></div>
  <div class="panel"><h3>Market contribution <span>share of ${esc(d.kpiName)}</span></h3>${barPanelInner(d.byRegion, d.totals.kpi)}</div></section>`;
}

function changesSection(d) {
  const c = d.changes;
  const head = `<section class="sec" id="changes"><div class="sec-head"><span class="num">07</span><h2>Changes since previous import</h2><span class="sub">${c ? `report run ${esc(c.prevRun || '—')} → ${esc(c.newRun || '—')} · ${filters.region ? esc(filters.region) : 'all markets'} · amounts in ${esc(c.currency)} at current exchange rates` : ''}</span></div>`;
  if (c === undefined) return head + `<div class="panel"><div class="empty">Loading changes…</div></div></section>`;
  if (!c) return head + `<div class="panel"><div class="empty">${d.changesError ? 'Changes could not be computed: ' + esc(d.changesError) : 'No previous import to compare with yet — the next import will show what changed.'}</div></div></section>`;
  const t = c.tot;
  const pct = (a, b) => b ? (100 * a / b).toFixed(1) + '%' : '—';
  const d3 = v => v === '' || v === null || v === undefined ? '' : (typeof v === 'number' ? (v < 0 ? '−' : '+') + fmtN(Math.abs(v)) : esc(v));
  const cls = v => typeof v === 'number' ? (v > 0 ? ' style="color:var(--pos)"' : v < 0 ? ' style="color:var(--neg)"' : '') : '';
  const dk = t.newKpi - t.prevKpi, db = t.newBill - t.prevBill;
  let h = head;
  h += `<div class="kpis">
    ${kpi(c.kpi && PROFILE === 'print' ? 'Earned revenue' : 'Blended revenue', `${fmtM(t.prevKpi)} → ${fmtM(t.newKpi)}`, 'head', `<b style="color:${dk>=0?'var(--pos)':'var(--neg)'}">${d3(dk)}</b> · ${pct(dk, t.prevKpi)}`)}
    ${kpi('Billed (complete)', `${fmtM(t.prevBill)} → ${fmtM(t.newBill)}`, 'billed', `<b style="color:${db>=0?'var(--pos)':'var(--neg)'}">${d3(db)}</b> · ${pct(db, t.prevBill)}`)}
    ${kpi('Lines', `${fmtI(t.prevLines)} → ${fmtI(t.newLines)}`, '', `<b>${d3(t.newLines - t.prevLines)}</b>`)}
    ${kpi('Added lines', fmtI(c.counts.added))}${kpi('Removed lines', fmtI(c.counts.removed))}${kpi('Changed values', fmtI(c.counts.changed))}
  </div>`;
  const rowHtml = (label, o) => { const dk = o.newKpi - o.prevKpi, db = o.newBill - o.prevBill; return `<tr><td>${esc(label)}</td><td class="n">${fmtN(o.prevKpi)}</td><td class="n">${fmtN(o.newKpi)}</td><td class="n"${cls(dk)}>${d3(dk)}</td><td class="n"${cls(dk)}>${pct(dk, o.prevKpi)}</td><td class="n">${d3(o.added)}</td><td class="n">${d3(o.removed)}</td><td class="n">${d3(o.changed)}</td><td class="n">${fmtN(o.prevBill)}</td><td class="n">${fmtN(o.newBill)}</td><td class="n"${cls(db)}>${d3(db)}</td><td class="n"${cls(db)}>${pct(db, o.prevBill)}</td></tr>`; };
  const totals = keys => keys.reduce((a, k) => { const o = t.byRegion[k] || t.byMonth[k]; ['prevKpi','newKpi','prevBill','newBill','added','removed','changed'].forEach(f => a[f] += o[f]); return a; }, { prevKpi: 0, newKpi: 0, prevBill: 0, newBill: 0, added: 0, removed: 0, changed: 0 });
  const thead = first => `<thead><tr><th>${first}</th><th class="n">Blended — prev</th><th class="n">Blended — now</th><th class="n">Δ</th><th class="n">Δ %</th><th class="n">of which added</th><th class="n">removed</th><th class="n">changed</th><th class="n">Billed — prev</th><th class="n">Billed — now</th><th class="n">Δ</th><th class="n">Δ %</th></tr></thead>`;
  const regions = Object.keys(t.byRegion).sort(), months = Object.keys(t.byMonth).sort();
  const tr = totals(regions);
  h += `<div class="panel" style="margin-top:16px"><h3>Change by market <span>Δ = added + removed + changed values</span></h3><div class="scroll"><table class="plain">${thead('Market')}<tbody>
    ${regions.map(r => rowHtml(r, t.byRegion[r])).join('')}<tr style="font-weight:600">${rowHtml('Total', tr).slice(4)}</tbody></table></div></div>`;
  const tm = totals(months);
  h += `<div class="panel" style="margin-top:16px"><h3>Change by month</h3><div class="scroll"><table class="plain">${thead('Month')}<tbody>
    ${months.map(m => rowHtml(shortPeriodSafe(m), t.byMonth[m])).join('')}<tr style="font-weight:600">${rowHtml('Total', tm).slice(4)}</tbody></table></div></div>`;
  // market × month Δ matrix
  const mrows = regions.map(r => ({ name: r, cells: months.reduce((o, m) => { const cc = t.byRegionMonth[r + '|' + m]; o[m] = cc ? cc.newKpi - cc.prevKpi : 0; return o; }, {}), total: t.byRegion[r].newKpi - t.byRegion[r].prevKpi }));
  h += `<div class="panel" style="margin-top:16px"><h3>Δ blended by market × month <span>${esc(c.currency)}</span></h3>${deltaMatrix(mrows, months, shortPeriodSafe, { name: 'Total', cells: months.reduce((o, m) => { o[m] = t.byMonth[m].newKpi - t.byMonth[m].prevKpi; return o; }, {}), total: tm.newKpi - tm.prevKpi })}</div>`;
