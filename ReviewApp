  const lastI = months.length - 1;
  return `<svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}" role="img" aria-label="Monthly trend"><polygon points="${area}" fill="#1e3a5f" opacity=".08"/><polyline points="${pts}" fill="none" stroke="#1e3a5f" stroke-width="2"/><circle cx="${x(lastI)}" cy="${y(months[lastI].total)}" r="4" fill="#1e3a5f"/><text x="${p}" y="${H - p + 0}" font-size="10" fill="#6b6f76" dy="-2">${shortPeriod(months[0].period)}</text><text x="${W - p}" y="${H - p}" font-size="10" fill="#6b6f76" text-anchor="end" dy="-2">${shortPeriod(months[lastI].period)}</text></svg>`;
}
function niceStep(x) { const p = Math.pow(10, Math.floor(Math.log10(x || 1))); const f = x / p; return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10) * p; }

